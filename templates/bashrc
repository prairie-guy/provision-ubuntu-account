### Emacs -----------------------
# doom's binaries (doom sync, doom doctor)
export PATH="$HOME/.config/emacs/bin:$PATH"

# Plain terminal Emacs (NO daemon). This is the default.
alias e='emacs -nw'
alias emacs='emacs -nw'
export EDITOR='emacs -nw'

# --- Optional daemon workflow (NOT auto-started) ---------------------------
# When you WANT the daemon for instant opens, run `edaemon-start` once, then use
# `ec` to connect. `\emacs` bypasses the alias above so these hit the real binary.
#   edaemon-start   : start the background daemon
#   ec [file]       : connect to it (terminal frame); auto-starts daemon if none
#   edaemon-stop    : shut the daemon down
#   edaemon-restart : reload config in the daemon
alias ec='emacsclient -t -a ""'
alias edaemon-start='\emacs --daemon'
alias edaemon-stop='emacsclient -e "(kill-emacs)"'
alias edaemon-restart='emacsclient -e "(kill-emacs)" 2>/dev/null; \emacs --daemon'

# To AUTO-START the daemon on login, uncomment the next block. NOTE: a daemon
# caches your config at start -- after editing ~/.config/doom run
# `edaemon-restart` to pick up changes.
#
# pgrep -u "$USER" -f 'emacs --daemon' >/dev/null || \emacs --daemon 2>/dev/null
# alias emacs='emacsclient -t -a ""'
# alias e='emacsclient -t -a ""'
# export EDITOR='emacsclient -t -a ""'


#### Conda / Mamba (miniforge3) -----------------------
# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$("$HOME/miniforge3/bin/conda" 'shell.bash' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "$HOME/miniforge3/etc/profile.d/conda.sh" ]; then
        . "$HOME/miniforge3/etc/profile.d/conda.sh"
    else
        export PATH="$HOME/miniforge3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

# >>> mamba initialize >>>
# !! Contents within this block are managed by 'mamba shell init' !!
export MAMBA_EXE="$HOME/miniforge3/bin/mamba"
export MAMBA_ROOT_PREFIX="$HOME/miniforge3"
__mamba_setup="$("$MAMBA_EXE" shell hook --shell bash --root-prefix "$MAMBA_ROOT_PREFIX" 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__mamba_setup"
else
    alias mamba="$MAMBA_EXE"  # Fallback on help from mamba activate
fi
unset __mamba_setup
# <<< mamba initialize <<<

# Default env. Must come after the mamba init block, and before anything below
# that lives in the env (fzf, zoxide) rather than in /usr/bin.
mamba activate __ENV_NAME__ 2>/dev/null


### Tools that live in the mamba env -----------------------
# Guarded: if the env failed to activate, a missing tool must not make every
# new shell spew errors.
if command -v fzf >/dev/null; then
    eval "$(fzf --bash)"
    [ -f ~/.fzf.bash ] && source ~/.fzf.bash
fi
command -v zoxide >/dev/null && eval "$(zoxide init bash)"


