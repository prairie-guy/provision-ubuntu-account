### Local bins
# Prepend only if not already present, so `source ~/.bashrc` in a configured
# shell does not grow PATH every time.
path_prepend() {
    case ":$PATH:" in
        *":$1:"*) ;;
        *) [ -d "$1" ] && PATH="$1:$PATH" ;;
    esac
}
path_prepend "$HOME/bin"
# ~/.local/bin is where curl-style installers (claude) land. Ubuntu's default
# ~/.profile adds it only if it exists at login, which is not true on a fresh
# account, so add it here too.
path_prepend "$HOME/.local/bin"
export PATH


