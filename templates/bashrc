### Local bins
export PATH="$HOME/bin:$PATH"
# ~/.local/bin is where curl-style installers (claude) land. Ubuntu's default
# ~/.profile adds it only if it exists at login, which is not true on a fresh
# account, so add it here too.
[ -d "$HOME/.local/bin" ] && export PATH="$HOME/.local/bin:$PATH"


