### Emacs -----------------------
# doom's binaries (doom sync, doom doctor)
path_prepend "$HOME/.config/emacs/bin"
export PATH

# Plain terminal Emacs (NO daemon). This is the default.
alias e='emacs -nw'
alias emacs='emacs -nw'
export EDITOR='emacs -nw'

# --- Optional daemon workflow (NOT auto-started) ---------------------------
# When you WANT the daemon for instant opens, run `edaemon-start` once, then use
# `ec` to connect. `\emacs` bypasses the alias above so these hit the real binary.
#   edaemon-start   : start the background daemon
#   ec [file]       : connect to it (terminal frame); auto-starts daemon if none
#   edaemon-stop    : shut the daemon down
#   edaemon-restart : reload config in the daemon
alias ec='emacsclient -t -a ""'
alias edaemon-start='\emacs --daemon'
alias edaemon-stop='emacsclient -e "(kill-emacs)"'
alias edaemon-restart='emacsclient -e "(kill-emacs)" 2>/dev/null; \emacs --daemon'

# To AUTO-START the daemon on login, uncomment the next block. NOTE: a daemon
# caches your config at start -- after editing ~/.config/doom run
# `edaemon-restart` to pick up changes.
#
# pgrep -u "$USER" -f 'emacs --daemon' >/dev/null || \emacs --daemon 2>/dev/null
