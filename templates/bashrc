# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$("$HOME/miniforge3/bin/conda" 'shell.bash' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "$HOME/miniforge3/etc/profile.d/conda.sh" ]; then
        . "$HOME/miniforge3/etc/profile.d/conda.sh"
    else
        export PATH="$HOME/miniforge3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

# >>> mamba initialize >>>
# !! Contents within this block are managed by 'mamba shell init' !!
export MAMBA_EXE="$HOME/miniforge3/bin/mamba"
export MAMBA_ROOT_PREFIX="$HOME/miniforge3"
__mamba_setup="$("$MAMBA_EXE" shell hook --shell bash --root-prefix "$MAMBA_ROOT_PREFIX" 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__mamba_setup"
else
    alias mamba="$MAMBA_EXE"  # Fallback on help from mamba activate
fi
unset __mamba_setup
# <<< mamba initialize <<<

# Default env. Must come after the mamba init block, and before anything below
# that lives in the env (fzf, zoxide) rather than in /usr/bin.
mamba activate __ENV_NAME__ 2>/dev/null


### Tools that live in the mamba env -----------------------
# Guarded: if the env failed to activate, a missing tool must not make every
# new shell spew errors.
if command -v fzf >/dev/null; then
    eval "$(fzf --bash)"
    [ -f ~/.fzf.bash ] && source ~/.fzf.bash
fi
command -v zoxide >/dev/null && eval "$(zoxide init bash)"


### Rootless Docker -----------------------
# Set only when this account actually has a rootless daemon, so the line is
# inert on accounts that do not (and on accounts that use the system daemon).
#
# The setup tool already creates a "rootless" CLI context, which is enough for
# the `docker` command itself. This is for everything that reads the
# environment instead of the CLI context -- the python docker SDK, testcontainers,
# anything driving docker from a script -- which would otherwise fall back to
# /var/run/docker.sock and fail with "permission denied".
_docker_sock="${XDG_RUNTIME_DIR:-/run/user/$UID}/docker.sock"
[ -S "$_docker_sock" ] && export DOCKER_HOST="unix://$_docker_sock"
unset _docker_sock


### CUDA / GPU -----------------------
# This is a shared AI box: several accounts use the same GPUs. Everything in
# this section is PER-USER and safe to set here. Anything needing root (power
# limits, persistence mode) is server-side -- see the bottom of this section.
#
# NOTE: the CUDA runtime comes from the mamba env (conda's cuda-* packages),
# not from a system CUDA install, so there is no /usr/local/cuda to add to
# PATH. Only the driver is system-level.

# Make CUDA number devices the way nvidia-smi does. Without this, CUDA orders
# by "fastest first", so device 0 in your code need not be GPU 0 in nvidia-smi
# -- which makes CUDA_VISIBLE_DEVICES and any per-user GPU split unreliable.
# Recommended on any multi-GPU box, so this one is ON by default.
export CUDA_DEVICE_ORDER=PCI_BUS_ID

# Restrict this account to specific GPUs, so concurrent users do not collide
# on the same card. Indices are as shown by nvidia-smi (with the setting
# above). This box has 4: 0,1,2,3.
#export CUDA_VISIBLE_DEVICES=0,1

# Reduces fragmentation-related OOMs on long-running jobs. Generally safe.
#export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Silences the noisy fork/parallelism warning from HF tokenizers.
#export TOKENIZERS_PARALLELISM=false

# Keep BLAS/OpenMP from grabbing every core when several users run at once.
#export OMP_NUM_THREADS=8

# SHARED MODEL CACHE. By default every account downloads its own copy of every
# model into ~/.cache/huggingface. On a box with 4x96GB cards the models are
# large enough that this wastes hundreds of GB. Point all accounts at one
# group-writable directory instead. Requires the directory to exist with a
# shared group and setgid (server-side setup):
#   sudo install -d -g gpuusers -m 2775 /srv/models
#export HF_HOME=/srv/models/huggingface
#export TORCH_HOME=/srv/models/torch

# --- Power capping and persistence mode -----------------------------------
# Both need root, so they are not set here. Use ~/bin/gpu-power instead:
#
#   gpu-power                 show current caps and total draw
#   gpu-power 500             cap every GPU at 500W
#   gpu-power 500 --persist   ...and enable persistence mode
#   gpu-power --reset         restore defaults
#
# Neither survives a reboot or driver reload -- for a permanent cap, use a
# systemd unit in the server provisioning script.
